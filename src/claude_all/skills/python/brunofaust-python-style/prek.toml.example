# ─────────────────────────────────────────────────────────────────────────────
# REFERENCE prek.toml — brunofaust-python-style
#
# This file is DOCUMENTATION, not an active config. Copy it to your repo root as
# `prek.toml` and delete what doesn't apply. It is the executable counterpart to
# `references/enforcement.md`: that file says WHAT each rule is, this says HOW it
# gets gated. The governing principle — a rule in prose gets violated; a rule
# encoded as a checker holds.
#
# ── WHY THE `.example` SUFFIX — KEEP IT ──────────────────────────────────────
# prek treats EVERY `prek.toml` it finds under the repo root as a workspace
# PROJECT (see `prek run [HOOK|PROJECT]`), not just the one at the root. A file
# literally named `prek.toml` sitting in a skill directory is therefore LOADED
# AND RUN by the host repo's own gate — and one stale `rev` in it breaks the
# whole gate with "Failed to init hooks" before a single check executes. The
# suffix is what keeps this a document instead of a landmine. Rename it only
# once it is in the repo that should actually run it.
#
# prek (https://github.com/j178/prek) is a faster, dependency-free Rust drop-in
# for pre-commit. It reads `.pre-commit-config.yaml` unchanged; `prek.toml` is
# its own optional format. Everything below works with either tool.
#
# ── WHY THE [[repos.hooks]] STYLE ────────────────────────────────────────────
# prek also accepts `hooks = [{ id = "x" }, ...]` inline tables, but multi-line
# inline tables with trailing commas are NOT valid strict TOML — `tomllib`, the
# `check-toml` hook, and most editors reject them. The array-of-tables form below
# parses under both prek and strict TOML, so use it.
#
# ── HOW TO ADOPT ON AN EXISTING CODEBASE ─────────────────────────────────────
# Do NOT switch all of this on at once — a gate that fails 400 times on day one
# gets `SKIP=`'d and then protects nothing. Roll each new rule out regression-
# only: baseline today's findings, fail on NEW ones, ratchet the baseline down.
# The `regression-gates` skill ships `baseline_gate.py` for exactly this.
#
# ── THE TWO THINGS THAT MAKE A GREEN RUN A LIE ───────────────────────────────
# 1. prek only inspects GIT-TRACKED files. A new untracked file is skipped and
#    the gate passes vacuously. `git add` before you trust a run. The tell is a
#    hook reporting "(no files to check) Skipped" — read the per-hook status
#    lines, not just the final colour.
# 2. `--all-files` runs only the PRE-COMMIT stage. Pre-push hooks go unexercised
#    until you also run `prek run --all-files --hook-stage pre-push`. Both stages
#    must be green before you claim a change is clean.
# ─────────────────────────────────────────────────────────────────────────────

default_language_version.python = "3.12"

# Hooks without an explicit `stages` run ONLY at pre-commit. Without this, every
# unstaged hook runs at EVERY stage — so anything invoking the whole suite (a
# Stop hook, CI) double-executes ruff, vulture, typos, gitleaks, …
default_stages = ["pre-commit"]

# Generated / vendored / not-hand-authored trees: formatters and spell-checkers
# only churn and false-positive on these.
exclude = { glob = [".venv/**", "vendor/**", "node_modules/**", "**/migrations/versions/**"] }


# ═════════════════════════════════════════════════════════════════════════════
# 1. REPO HYGIENE — the defaults every repo should have, Python or not
# ═════════════════════════════════════════════════════════════════════════════

[[repos]]
repo = "https://github.com/pre-commit/pre-commit-hooks"
rev = "v6.0.0"

# — structural validity —
[[repos.hooks]]
id = "check-json"
name = "✅ check · Valid JSON"

[[repos.hooks]]
id = "check-toml"
name = "✅ check · Valid TOML"

[[repos.hooks]]
id = "check-yaml"
name = "✅ check · Valid YAML"

[[repos.hooks]]
id = "check-xml"
name = "✅ check · Valid XML"

[[repos.hooks]]
id = "debug-statements"
name = "✅ check · No leftover breakpoint()/pdb"

# — whitespace/EOL formatters: pre-push only, so a commit is never blocked by
#   churn the tool fixes itself —
[[repos.hooks]]
id = "end-of-file-fixer"
name = "✅ check · Newline at EOF"
stages = ["pre-push"]

[[repos.hooks]]
id = "trailing-whitespace"
name = "✅ check · No trailing whitespace"
stages = ["pre-push"]

[[repos.hooks]]
id = "mixed-line-ending"
name = "✅ check · Consistent line endings"
stages = ["pre-push"]

# — filesystem —
[[repos.hooks]]
id = "check-case-conflict"
name = "📁 fs · No case-only filename collisions"

[[repos.hooks]]
id = "check-executables-have-shebangs"
name = "📁 fs · +x files have a shebang"

[[repos.hooks]]
id = "check-symlinks"
name = "📁 fs · No broken symlinks"

[[repos.hooks]]
id = "destroyed-symlinks"
name = "📁 fs · No symlink turned into a regular file"

# — git —
[[repos.hooks]]
id = "check-merge-conflict"
name = "🌳 git · No conflict markers"

[[repos.hooks]]
id = "forbid-new-submodules"
name = "🌳 git · No new submodules"

[[repos.hooks]]
id = "no-commit-to-branch"
name = "🌳 git · Protect the default branch"

[[repos.hooks]]
id = "check-added-large-files"
name = "🌳 git · Block large blobs"
args = ["--maxkb=5000"]

# — tests —
# `--pytest-test-first` enforces test_*.py over *_test.py. Pick one and gate it;
# two spellings means a glob somewhere will miss half your tests.
[[repos.hooks]]
id = "name-tests-test"
name = "🧪 test · Test files are test_*.py"
args = ["--pytest-test-first"]
files = "^tests/.+\\.py$"


[[repos]]
repo = "https://github.com/crate-ci/typos"
rev = "v1.29.4"

[[repos.hooks]]
id = "typos"
name = "🔍 content · Spelling"


[[repos]]
repo = "https://github.com/gitleaks/gitleaks"
rev = "v8.23.1"

[[repos.hooks]]
id = "gitleaks"
name = "🔒 security · No committed secrets"


[[repos]]
repo = "https://github.com/commitizen-tools/commitizen"
rev = "v4.1.0"

[[repos.hooks]]
id = "commitizen"
name = "🌳 git · Conventional commit message"
stages = ["commit-msg"]


# ═════════════════════════════════════════════════════════════════════════════
# 2. PYTHON TOOLCHAIN
# ═════════════════════════════════════════════════════════════════════════════

[[repos]]
repo = "https://github.com/astral-sh/ruff-pre-commit"
rev = "v0.9.4"

[[repos.hooks]]
id = "ruff-check"
name = "🐍 python · Lint (ruff)"
args = ["--fix"]

# Formatter — pre-push, same rationale as the whitespace fixers above.
[[repos.hooks]]
id = "ruff-format"
name = "🐍 python · Format (ruff)"
stages = ["pre-push"]


[[repos]]
repo = "https://github.com/asottile/pyupgrade"
rev = "v3.19.1"

[[repos.hooks]]
id = "pyupgrade"
name = "🐍 python · Modern syntax"
args = ["--py312-plus"]


[[repos]]
repo = "https://github.com/pre-commit/pygrep-hooks"
rev = "v1.10.0"

[[repos.hooks]]
id = "python-check-blanket-type-ignore"
name = "🐍 python · No blanket # type: ignore"

[[repos.hooks]]
id = "python-check-mock-methods"
name = "🐍 python · No assert_called_once typo'd as an attribute"

[[repos.hooks]]
id = "python-no-log-warn"
name = "🐍 python · log.warning, not deprecated log.warn"

[[repos.hooks]]
id = "python-use-type-annotations"
name = "🐍 python · Annotations, not type comments"

[[repos.hooks]]
id = "text-unicode-replacement-char"
name = "🐍 python · No U+FFFD replacement char"


# ⚠️ language_version MUST be pinned per-hook on bandit / vulture.
# They parse with the interpreter's own `ast`, so on an older interpreter they
# silently SKIP files they cannot parse and still exit 0 — a vacuous pass. A
# repo-level `default_language_version` does NOT reach a hook's isolated env.
# Tools with their own parser (ruff, jscpd) are immune — don't cargo-cult the pin.
[[repos]]
repo = "https://github.com/PyCQA/bandit"
rev = "1.8.2"

# Ruff's `S` group ports most of bandit; keep bandit for what it hasn't ported.
[[repos.hooks]]
id = "bandit"
name = "🔒 security · SAST (bandit)"
args = ["-c", "pyproject.toml"]
language_version = "python3.12"


[[repos]]
repo = "https://github.com/jendrikseipp/vulture"
rev = "v2.14"

# ⚠️ vulture counts a call FROM A TEST as a use, so a helper whose only callers
# live in tests/ reads as live while production silently lost its wiring. See
# references/enforcement.md, "A `src`-dead, test-alive function is a finding".
[[repos.hooks]]
id = "vulture"
name = "🐍 python · Dead code"
language_version = "python3.12"


[[repos]]
repo = "https://github.com/abravalheri/validate-pyproject"
rev = "v0.23"

[[repos.hooks]]
id = "validate-pyproject"
name = "📦 deps · pyproject.toml schema"


[[repos]]
repo = "https://github.com/tox-dev/pyproject-fmt"
rev = "v2.5.0"

[[repos.hooks]]
id = "pyproject-fmt"
name = "📦 deps · Format pyproject.toml"
stages = ["pre-push"]


[[repos]]
repo = "https://github.com/astral-sh/uv-pre-commit"
rev = "0.5.26"

# Can rewrite uv.lock — defer to push so a commit is never blocked by a relock.
[[repos.hooks]]
id = "uv-lock"
name = "📦 deps · uv.lock matches pyproject"
stages = ["pre-push"]


# ═════════════════════════════════════════════════════════════════════════════
# 3. LOCAL GATES — type-check, dependency CVEs, duplication, layering
#
# `language = "system"` runs these in YOUR project venv rather than an isolated
# hook env. That is deliberate: mypy needs your installed dependencies to
# resolve types at all.
# ═════════════════════════════════════════════════════════════════════════════

[[repos]]
repo = "local"

# Whole-tree, not per-file: a change in one module breaks types in an untouched
# importer, which per-file mode never sees.
[[repos.hooks]]
id = "mypy"
name = "🐍 python · Type-check (mypy)"
entry = "uv run mypy"
language = "system"
types_or = ["python"]
pass_filenames = false
always_run = true
stages = ["pre-push"]

# ⚠️ THE GAP MOST REPOS HAVE. Lockfile CVE scan against the PyPI advisory DB —
# nothing else here looks at your dependencies' known vulnerabilities.
[[repos.hooks]]
id = "uv-audit"
name = "🔒 security · Dependency CVEs"
entry = "uv audit"
language = "system"
pass_filenames = false
always_run = true
stages = ["pre-push"]

# Catches copy-paste (same TEXT) only — NOT same-responsibility-different-text.
# Structural duplication is invisible to it at any threshold. Its allowlist is a
# burn-down list, not a graveyard.
[[repos.hooks]]
id = "jscpd"
name = "🧬 dup · Copy-paste detection"
entry = "npx --yes jscpd --threshold 1 --reporters consoleFull --min-lines 12"
language = "system"
pass_filenames = false
always_run = true
stages = ["pre-push"]

# Import-direction / layering contracts, declared under [tool.importlinter] in
# pyproject.toml. See references/architecture.md + project-structure.md.
[[repos.hooks]]
id = "import-linter"
name = "🏗️ architecture · Import direction"
entry = "uv run lint-imports"
language = "system"
types_or = ["python"]
pass_filenames = false
always_run = true
stages = ["pre-push"]


# ═════════════════════════════════════════════════════════════════════════════
# 4. THIS SKILL'S OWN CHECKERS — from the claude-all hook repo
#
# Don't copy checker scripts into the repo. Generate this block in the project root:
#     claude-all --install-hooks          # (--dry-run first to see the diff)
# It offers only the hooks of your installed skills, fills args from the layout, pins
# `rev` to your claude-all release, and rewrites only the block between the markers.
# Each checker is a pure AST/text parse; it exits 1 on findings and 2 when it can't
# parse or scans zero files, so a bad setup fails loudly instead of passing.
#
# Existing debt? Seed a baseline and ratchet instead of disabling a hook:
#     claude-all-check migration-head --baseline migration_head_baseline.txt --update alembic/versions
#     { id = "migration-head", args = ["--baseline", "migration_head_baseline.txt", "alembic/versions"] }
# ═════════════════════════════════════════════════════════════════════════════

# >>> claude-all hooks (managed by `claude-all --install-hooks`; don't edit) >>>
[[repos]]
repo = "https://github.com/brunofaust/claude-all"
rev = "v0.17.0"
hooks = [
  { id = "model-contract", args = ["src"] },
  { id = "pydantic-contract", args = ["src"] },
  { id = "all-contract", args = ["--package", "myapp", "src"] },
  { id = "flat-test-mirror", args = ["--root", "tests/unit"] },
  { id = "docstring-budget" },
  { id = "async-mock-target", args = ["src", "tests"] },
  { id = "patch-target-exists", args = ["src", "tests"] },
  { id = "mock-assert-signature", args = ["--check", "src", "tests"] },
  { id = "unspecced-model-mock", args = ["--check", "src", "tests"] },
  { id = "junk-drawer", args = ["src"] },
  { id = "module-private", args = ["src"] },
  { id = "migration-head", args = ["alembic/versions"] },
]
# <<< claude-all hooks <<<
